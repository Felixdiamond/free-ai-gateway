# Browser Configuration
HEADLESS=False
# BROWSER_PATH=/usr/bin/chromium

# Provider URLs (Optional - defaults shown)
# CHATGPT_URL=https://chatgpt.com
# GEMINI_URL=https://gemini.google.com/app
# GROK_URL=https://grok.com

# Timeout Configuration (in seconds)
# Adjust these for slower network connections
TIMEOUT_INPUT=10          # Wait time for input fields to appear
TIMEOUT_BUTTON=5          # Wait time for buttons to appear
TIMEOUT_RESPONSE=120      # Max wait time for AI response
TIMEOUT_STABLE_CONTENT=30 # Wait for response content to stabilize
TIMEOUT_PAGE_LOAD=15      # Page load timeout
TIMEOUT_ELEMENT_CHECK=1   # Quick element existence check

# Tab Management Configuration
TAB_INACTIVE_MINUTES=10   # Close tabs inactive for this many minutes
TAB_POOL_SIZE=3           # Max anonymous tabs per provider
TAB_CLEANUP_INTERVAL=60   # Seconds between cleanup runs